# Copy to .env and change every value before running anything real.
# Only dummy values live here; no real secret is ever committed.

# --- Application database role -------------------------------------------
# MUST NOT be a superuser and MUST NOT hold BYPASSRLS: row level security is
# the second half of tenant isolation and a privileged role silently disables it.
DESTEKTESVIK_DATABASE_URL=postgresql+psycopg://destektesvik_app:dummy-app-password@db:5432/destektesvik

# --- Migration / owner role ----------------------------------------------
# Separate from the application role on purpose. Only migrations use it.
DESTEKTESVIK_MIGRATION_DATABASE_URL=postgresql+psycopg://destektesvik_owner:dummy-owner-password@db:5432/destektesvik
DESTEKTESVIK_APP_DB_ROLE=destektesvik_app

# --- Compose-only database bootstrap values ------------------------------
POSTGRES_DB=destektesvik
POSTGRES_USER=destektesvik_owner
POSTGRES_PASSWORD=dummy-owner-password
DESTEKTESVIK_APP_DB_PASSWORD=dummy-app-password

# --- Web ------------------------------------------------------------------
# Signs the CSRF token. Generate a fresh random value per environment.
DESTEKTESVIK_SECRET_KEY=dummy-secret-change-me
# Set to true wherever TLS terminates in front of the application.
DESTEKTESVIK_SESSION_COOKIE_SECURE=false
DESTEKTESVIK_SESSION_COOKIE_SAMESITE=lax
DESTEKTESVIK_SESSION_TTL_SECONDS=43200
DESTEKTESVIK_ENVIRONMENT=development

# --- AI (optional, disabled by default) ----------------------------------
# "disabled" | "fake" | "openai_compatible".
# The deterministic engine is complete without any of these.
DESTEKTESVIK_AI_PROVIDER=disabled
DESTEKTESVIK_AI_BASE_URL=
DESTEKTESVIK_AI_API_KEY=
DESTEKTESVIK_AI_MODEL=
DESTEKTESVIK_AI_TIMEOUT_SECONDS=30
