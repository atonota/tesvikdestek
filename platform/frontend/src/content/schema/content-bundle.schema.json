{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://destektesvik.internal/schema/content-bundle.schema.json",
  "title": "ContentBundle",
  "description": "A migration-ready frontend content bundle. Every entry carries the fields a future content_entries PostgreSQL table would carry unchanged: stable id, locale, namespace, revision, status, kind, value, optional variables and context, and source metadata.",
  "type": "object",
  "required": ["schemaVersion", "namespace", "locale", "revision", "status", "source", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "namespace": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "published", "archived"] },
    "source": { "$ref": "#/$defs/source" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "state": { "type": "string" },
        "component": { "type": "string" }
      }
    },
    "entry": {
      "type": "object",
      "required": ["id", "namespace", "locale", "revision", "status", "kind", "value", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["draft", "published", "archived"] },
        "kind": { "enum": ["text", "html", "markdown"] },
        "value": { "type": "string" },
        "variables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source": { "$ref": "#/$defs/source" },
        "context": { "$ref": "#/$defs/context" }
      }
    }
  }
}
