{
  "name": "@destektesvik/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DestekTesvik karar ve kanit tezgahi - frontend-only enterprise surface",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build && vitest run src/test/build-contract.test.ts src/test/no-mock-artifacts.test.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:pages:build": "VITE_STATIC_DEMO_ONLY=true vite build --base /tesvikdestek/uygulama/ --outDir dist-pages",
    "e2e:pages": "pnpm run e2e:pages:build && playwright test --config=playwright.pages.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "5.3.0",
    "@hookform/resolvers": "5.8.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "7.18.2",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@storybook/react-vite": "10.5.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "storybook": "10.5.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
